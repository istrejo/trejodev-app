{
  "name": "trejodev-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro:sync": "astro sync",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ready:deploy": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.7",
    "astro": "^7.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.8"
  }
}
