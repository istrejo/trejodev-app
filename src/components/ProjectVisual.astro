---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  large?: boolean;
}

const { src, alt, caption, large = false } = Astro.props;
---

<figure class:list={["project-visual", { "project-detail-visual": large }]}>
  <img
    alt={alt}
    class="project-image"
    loading={large ? "eager" : "lazy"}
    src={src}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
