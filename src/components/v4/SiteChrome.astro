---
import type { Locale } from "@/lib/i18n";
import type { RouteTarget } from "@/lib/routes";
import {
  chromeCopy,
  localeSwitchPath,
  profileSocialLinks,
  v4NavItems,
} from "./chrome";

interface Props {
  locale: Locale;
  route: RouteTarget;
}

const { locale, route } = Astro.props;
const copy = chromeCopy[locale];
const navItems = v4NavItems(locale);
const switchPath = localeSwitchPath(locale, route);
const routeKey = typeof route === "object" ? "projects" : route;
const navLabel = locale === "en" ? "Primary navigation" : "Navegación principal";
const iconPaths = {
  linkedin:
    "M4.98 3.5C4.98 4.88 3.86 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.36 8.08h4.28V22H.36zM7.3 8.08h4.1v1.9h.06c.57-1.08 1.97-2.22 4.06-2.22 4.34 0 5.14 2.86 5.14 6.57V22h-4.28v-6.78c0-1.62-.03-3.7-2.25-3.7-2.25 0-2.6 1.76-2.6 3.58V22H7.3z",
  github:
    "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.9 1.2 3.2 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z",
} as const;
---

<div class="site-shell">
  <header class="site-header" data-site-header>
    <div class="site-nav-wrap">
      <a aria-label="Alejandro Trejo — Home" class="brand" href={`/${locale}`}>
        <img alt="Alejandro Trejo logo" class="brand-logo" height="398" src="/logo.png" width="400" />
      </a>

      <nav aria-label={navLabel} class="desktop-nav glass-panel">
        {navItems.map((item) => (
          <a aria-current={item.key === routeKey ? "page" : undefined} href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="header-actions">
        <a aria-label={copy.locale} class="icon-button locale-button" href={switchPath} hreflang={locale === "en" ? "es" : "en"}>
          {locale === "en" ? "ES" : "EN"}
        </a>
        <button aria-label={locale === "en" ? "Toggle color theme" : "Cambiar tema de color"} aria-pressed="false" class="icon-button" data-theme-toggle type="button">
          <svg aria-hidden="true" fill="none" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
        </button>
        <button aria-controls="mobile-nav-panel" aria-expanded="false" aria-label={copy.menu} class="icon-button mobile-toggle" data-nav-toggle data-close-label={copy.close} data-open-label={copy.menu} type="button">
          <span></span><span></span>
        </button>
      </div>
    </div>

    <nav aria-hidden="true" aria-label={navLabel} class="mobile-panel glass-panel" id="mobile-nav-panel" inert>
      {navItems.map((item) => (
        <a aria-current={item.key === routeKey ? "page" : undefined} href={item.href}>{item.label}</a>
      ))}
      <a href={switchPath} hreflang={locale === "en" ? "es" : "en"}>{locale === "en" ? "Español" : "English"}</a>
    </nav>
  </header>

  <slot />

  <footer class="site-footer">
    <div>
      <nav aria-label={locale === "en" ? "Footer navigation" : "Navegación del pie"}>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <p>© 2026 Alejandro Trejo</p>
    </div>
    <div class="social-links">
      {profileSocialLinks.map((link) => (
        <a aria-label={link.label} href={link.href} rel="noreferrer" target="_blank">
          <svg aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d={iconPaths[link.kind]} /></svg>
        </a>
      ))}
    </div>
  </footer>
</div>

<script>
  const bindChrome = () => {
    const root = document.documentElement;
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const panel = document.querySelector<HTMLElement>("#mobile-nav-panel");

    if (themeToggle) {
      const isDark = root.dataset.theme === "dark";
      themeToggle.setAttribute("aria-pressed", String(isDark));
      themeToggle.onclick = () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("trejodev-theme", next);
        themeToggle.setAttribute("aria-pressed", String(next === "dark"));
      };
    }

    const closeMenu = (restoreFocus = false) => {
      if (!navToggle || !panel) return;
      const wasOpen = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", "false");
      navToggle.setAttribute("aria-label", navToggle.dataset.openLabel ?? "Menu");
      panel.dataset.open = "false";
      panel.setAttribute("aria-hidden", "true");
      panel.inert = true;
      if (restoreFocus && wasOpen) navToggle.focus();
    };

    if (navToggle && panel) {
      closeMenu();
      navToggle.onclick = () => {
        const open = navToggle.getAttribute("aria-expanded") !== "true";
        if (!open) {
          closeMenu(true);
          return;
        }
        navToggle.setAttribute("aria-expanded", String(open));
        navToggle.setAttribute("aria-label", open ? navToggle.dataset.closeLabel ?? "Close" : navToggle.dataset.openLabel ?? "Menu");
        panel.dataset.open = String(open);
        panel.setAttribute("aria-hidden", String(!open));
        panel.inert = !open;
        panel.querySelector<HTMLAnchorElement>("a")?.focus();
      };
      panel.onclick = (event) => {
        if (event.target instanceof Element && event.target.closest("a")) closeMenu(true);
      };
      document.onkeydown = (event) => {
        if (event.key !== "Escape") return;
        event.preventDefault();
        closeMenu(true);
      };
    }

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sections = document.querySelectorAll<HTMLElement>("[data-reveal]");
    if (reduceMotion || !("IntersectionObserver" in window)) {
      sections.forEach((section) => section.dataset.visible = "true");
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.visible = "true";
          observer.unobserve(entry.target);
        });
      }, { rootMargin: "0px 0px -8%", threshold: 0.08 });
      sections.forEach((section) => observer.observe(section));
    }
  };

  document.addEventListener("astro:page-load", bindChrome);
</script>
