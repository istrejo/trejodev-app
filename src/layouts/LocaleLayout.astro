---
import type { Locale } from "@/lib/i18n";
import { pageMetadata } from "@/lib/metadata";
import type { RouteTarget } from "@/lib/routes";
import SiteChrome from "@/components/v4/SiteChrome.astro";
import "../app/globals.css";
import "../styles/v4.css";

interface Props {
  locale: Locale;
  route: RouteTarget;
  heading: string;
  description: string;
}

const { locale, route, heading, description } = Astro.props;
const meta = pageMetadata(locale, route, heading, description);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.alternates.canonical} />
    <link rel="alternate" hreflang="en" href={meta.alternates.languages.en} />
    <link rel="alternate" hreflang="es" href={meta.alternates.languages.es} />
  </head>
  <body class="font-sans antialiased">
    <SiteChrome locale={locale} route={route}>
      <main class="min-h-screen px-5 pb-10 pt-8 text-ink sm:px-8 lg:px-10">
        <slot />
      </main>
    </SiteChrome>
  </body>
</html>
