---
import type { Locale } from "@/lib/i18n";
import { pageMetadata } from "@/lib/metadata";
import type { RouteTarget } from "@/lib/routes";
import SiteChrome from "@/components/v4/SiteChrome.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/hanken-grotesk";
import "../styles/global.css";

interface Props {
  locale: Locale;
  route: RouteTarget;
  heading: string;
  description: string;
}

const { locale, route, heading, description } = Astro.props;
const meta = pageMetadata(locale, route, heading, description);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.alternates.canonical} />
    <link rel="alternate" hreflang="en" href={meta.alternates.languages.en} />
    <link rel="alternate" hreflang="es" href={meta.alternates.languages.es} />
    <link rel="alternate" hreflang="x-default" href={meta.alternates.languages.en} />
    <meta property="og:type" content={meta.openGraph.type} />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:locale" content={meta.openGraph.locale} />
    <meta property="og:image" content={meta.openGraph.image} />
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />
    <meta name="theme-color" content="#121414" />
    <link rel="icon" href="/logo.png" type="image/png" />
    <script is:inline>
      (() => {
        const themeStorageKey = "trejodev-theme";
        const resolveTheme = () => {
          const stored = localStorage.getItem(themeStorageKey);
          return stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)
            ? "dark"
            : "light";
        };
        const applyTheme = (targetDocument, theme) => {
          targetDocument.documentElement.dataset.theme = theme;
        };

        document.documentElement.classList.add("js");
        applyTheme(document, resolveTheme());

        document.addEventListener("astro:before-swap", (event) => {
          const newDocument = event.newDocument;
          if (newDocument) applyTheme(newDocument, document.documentElement.dataset.theme ?? resolveTheme());
        });

        document.addEventListener("astro:after-swap", () => {
          applyTheme(document, resolveTheme());
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "en" ? "Skip to content" : "Saltar al contenido"}</a>
    <SiteChrome locale={locale} route={route}>
      <main id="main-content">
        <slot />
      </main>
    </SiteChrome>
  </body>
</html>
