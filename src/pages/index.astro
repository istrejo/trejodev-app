---
import { defaultLocale, localeNames, locales } from "@/lib/i18n";
import "../app/globals.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=/${defaultLocale}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TrejoDev</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-bone px-5 py-16 text-ink font-sans">
    <main class="motion-section max-w-xl rounded-[2rem] border border-line bg-paper p-8 text-center shadow-soft">
      <h1 class="font-display text-4xl font-black tracking-[-0.06em]">Redirecting to English</h1>
      <p class="mt-4 text-base leading-7 text-slate">If the redirect does not start automatically, choose a language below.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {locales.map((locale) => (
          <a class="rounded-full border border-line px-5 py-2.5 text-sm font-bold" href={`/${locale}`}>
            {localeNames[locale]}
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
