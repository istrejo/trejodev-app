---
import type { GetStaticPaths } from "astro";
import { contentFor } from "@/content";
import type { Locale } from "@/lib/i18n";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeStaticPaths } from "@/lib/astro-static-paths";
import { skillsPageCopy } from "@/translations/pages";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const page = contentFor(locale).skills;
const copy = skillsPageCopy[locale];
---

<LocaleLayout locale={locale} route="skills" heading={page.title} description={page.description}>
  <section class="page-hero narrow"><div class="container hero-copy" data-reveal><p class="eyebrow">{page.eyebrow}</p><h1 class="page-title">{page.title}</h1><p class="lead">{page.description}</p></div></section>
  <section aria-labelledby="skills-title" class="section surface">
    <div class="container" data-reveal>
      <div class="section-heading"><p class="eyebrow">{copy.coreStack}</p><div><h2 id="skills-title">{copy.sectionTitle}</h2><p>{copy.sectionDescription}</p></div></div>
      <div class="card-grid">{copy.cards.map((card) => <article class="card"><h3>{card.title}</h3><p>{card.description}</p>{card.footer && <p class="card-footer">{card.footer}</p>}</article>)}</div>
    </div>
  </section>
</LocaleLayout>
