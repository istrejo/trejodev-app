---
import type { GetStaticPaths } from "astro";
import { projectFor, type ProjectSlug } from "@/content";
import ProjectVisual from "@/components/ProjectVisual.astro";
import type { Locale } from "@/lib/i18n";
import { pathFor } from "@/lib/routes";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeProjectStaticPaths } from "@/lib/astro-static-paths";

export const getStaticPaths = (() =>
  localeProjectStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug as ProjectSlug;
const project = projectFor(locale, slug);
if (!project) throw new Error(`Missing project content for ${locale}/${slug}`);

const copy =
  locale === "en"
    ? {
        back: "Back to projects",
        overview: "Project overview",
        foundation: "Implemented foundation",
        roadmap: "Roadmap status",
        gallery: "Product interface gallery",
        repositories: "Source repositories",
        role: "Role",
        period: "Period",
      }
    : {
        back: "Volver a proyectos",
        overview: "Resumen del proyecto",
        foundation: "Base implementada",
        roadmap: "Estado del roadmap",
        gallery: "Galería de interfaces del producto",
        repositories: "Repositorios de código fuente",
        role: "Rol",
        period: "Período",
      };
---

<LocaleLayout
  locale={locale}
  route={{ key: "project-detail", slug }}
  heading={project.name}
  description={project.summary}
>
  <section class="page-hero project-detail-hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">{copy.overview}</p>
        <h1 class="page-title">{project.name}</h1>
        <p class="lead">{project.summary}</p>
        <dl class="project-meta">
          <div><dt>{copy.role}</dt><dd>{project.role}</dd></div><div>
            <dt>{copy.period}</dt><dd>{project.period}</dd>
          </div>
        </dl>
      </div>
      <div data-reveal>
        <a class="button" href={pathFor(locale, "projects")}>← {copy.back}</a>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="container" data-reveal>
      <ProjectVisual
        alt={project.cover.alt}
        caption={project.cover.caption}
        large
        src={project.cover.src}
      />
    </div>
  </section>

  <section class="section">
    <div class="container split-grid" data-reveal>
      <div>
        <p class="eyebrow">{copy.foundation}</p><h2>{copy.foundation}</h2>
      </div>
      <div class="stack-list">
        {
          project.foundation.map((section) => (
            <article class="stack-row">
              <>
                <h3>{section.title}</h3>
                <p>{section.description}</p>
              </>
            </article>
          ))
        }
        <article class="stack-row">
          <h3>{copy.roadmap}</h3><p>{project.roadmap.description}</p>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="project-gallery" class="section surface">
    <div class="container" data-reveal>
      <p class="eyebrow">{copy.gallery}</p>
      <h2 id="project-gallery">{copy.gallery}</h2>
      <div class="project-gallery">
        {
          project.screenshots.map((screenshot) => (
            <ProjectVisual
              alt={screenshot.alt}
              caption={screenshot.caption}
              src={screenshot.src}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="project-repositories" class="section">
    <div class="container split-grid" data-reveal>
      <div>
        <p class="eyebrow">{copy.repositories}</p><h2 id="project-repositories">
          {copy.repositories}
        </h2>
      </div>
      <div class="project-repositories">
        {
          project.repositories.map((repository) => (
            <a
              class="button button-secondary"
              href={repository.href}
              rel="noreferrer"
              target="_blank"
            >
              {repository.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</LocaleLayout>
