---
import type { GetStaticPaths } from "astro";
import { contentFor } from "@/content";
import type { Locale } from "@/lib/i18n";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeStaticPaths } from "@/lib/astro-static-paths";
import { profileLinks } from "@/data/links";
import { pathFor } from "@/lib/routes";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const home = contentFor(locale).home;
---

<LocaleLayout locale={locale} route="home" heading={home.title} description={home.description}>
  <section class="page-hero">
    <div class="container hero-copy" data-reveal>
      <p class="eyebrow">{home.eyebrow}</p>
      <h1 class="display-title">{home.title}<span aria-hidden="true" class="text-cursor"></span></h1>
      <p class="lead">{home.description}</p>
      <div class="button-row">
        {profileLinks.map((link, index) => (
          <a
            class:list={["button", { primary: index === 0 }]}
            href={link.href}
            rel="noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="outcomes-title" class="section surface">
    <div class="container home-proof-grid">
      <div data-reveal>
        <p class="eyebrow">{home.proofTitle}</p>
        <h2 id="outcomes-title">{home.proofHeading}</h2>
        <p class="lead">{home.proofDescription}</p>
        <div class="outcomes">
          {home.proofRows.map((row, index) => (
            <article class="outcome">
              <strong>{home.proofLabels[index]}</strong>
              <p>{row}</p>
            </article>
          ))}
        </div>
      </div>

      <div data-reveal>
        <p class="eyebrow">{locale === "en" ? "Experience" : "Experiencia"}</p>
        <h2>{home.timelineTitle}</h2>
        <p class="lead">{home.timelineDescription}</p>
        <ol class="timeline">
          {home.timelineEntries.map(([mark, company, role, description, dates, emphasized]) => (
            <li>
              <span aria-hidden="true" class:list={["timeline-dot", { current: emphasized }]}></span>
              <span aria-hidden="true" class="timeline-mark">{mark}</span>
              <div class="timeline-copy"><strong>{company}</strong><span>{role}</span><p>{description}</p></div>
              <p class="timeline-date">{dates}</p>
            </li>
          ))}
        </ol>
        <div class="button-row"><a class="button" href={pathFor(locale, "work")}>{locale === "en" ? "View full work history" : "Ver experiencia completa"}</a></div>
      </div>
    </div>
  </section>
</LocaleLayout>
