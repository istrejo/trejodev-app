---
import type { GetStaticPaths } from "astro";
import type { Locale } from "@/lib/i18n";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeStaticPaths } from "@/lib/astro-static-paths";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
---

<LocaleLayout locale={locale} route="work" heading={locale === "en" ? "Work shell" : "Shell de Trabajo"} description={locale === "en" ? "Work experience cards and verified facts remain for later implementation slices." : "Las cards de experiencia y los facts verificados quedan para slices posteriores."}>
  <section class="mx-auto max-w-5xl rounded-[2rem] border border-line bg-paper p-8 shadow-soft">
    <h1 class="font-display text-4xl font-black tracking-[-0.06em]">{locale === "en" ? "Work shell" : "Shell de Trabajo"}</h1>
    <p class="mt-4 text-base leading-7 text-slate">{locale === "en" ? "Work experience cards and verified facts remain for later implementation slices." : "Las cards de experiencia y los facts verificados quedan para slices posteriores."}</p>
  </section>
</LocaleLayout>
