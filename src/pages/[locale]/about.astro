---
import type { GetStaticPaths } from "astro";
import { contentFor } from "@/content";
import { profileSocialLinks } from "@/components/v4/chrome";
import type { Locale } from "@/lib/i18n";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeStaticPaths } from "@/lib/astro-static-paths";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const about = contentFor(locale).about;
---

<LocaleLayout locale={locale} route="about" heading={about.title} description={about.description}>
  <section class="page-hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">{about.eyebrow}</p>
        <h1 class="page-title">{about.title}</h1>
        {about.paragraphs.map((paragraph) => <p class="lead">{paragraph}</p>)}
      </div>
      <aside data-reveal>
        <div class="portrait-frame">
          <img
            alt={locale === "en" ? "Portrait of Alejandro Trejo" : "Retrato de Alejandro Trejo"}
            class="portrait-image"
            decoding="async"
            fetchpriority="high"
            height="1449"
            src="/profile.png"
            width="1085"
          />
        </div>
        <p class="eyebrow" style="margin-top: 1.5rem">{about.networksLabel}</p>
        <ul class="profile-list">
          {profileSocialLinks.map((link) => <li><a href={link.href} rel="noreferrer" target="_blank"><strong>{link.label}</strong><span>{link.value}</span></a></li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section aria-labelledby="principles-title" class="section surface">
    <div class="container split-grid" data-reveal>
      <div><p class="eyebrow">{locale === "en" ? "Practice" : "Práctica"}</p><h2 id="principles-title">{about.principlesTitle}</h2></div>
      <div class="stack-list">
        {about.principles.map((principle) => <article class="stack-row"><h3>{principle.title}</h3><p>{principle.description}</p></article>)}
      </div>
    </div>
  </section>

  <section aria-labelledby="focus-title" class="section">
    <div class="container split-grid" data-reveal>
      <div><p class="eyebrow">{locale === "en" ? "Toolkit" : "Herramientas"}</p><h2 id="focus-title">{about.focusTitle}</h2></div>
      <div class="stack-list">
        {about.focusRows.map((row) => <article class="stack-row"><h3>{row.label}</h3><p>{row.value}</p></article>)}
      </div>
    </div>
  </section>
</LocaleLayout>
