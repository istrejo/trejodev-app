---
import type { GetStaticPaths } from "astro";
import { contentFor } from "@/content";
import { profileSocialLinks } from "@/components/v4/chrome";
import type { Locale } from "@/lib/i18n";
import LocaleLayout from "@/layouts/LocaleLayout.astro";
import { localeStaticPaths } from "@/lib/astro-static-paths";

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;
const locale = Astro.params.locale as Locale;
const about = contentFor(locale).about;
---

<LocaleLayout locale={locale} route="about" heading={about.title} description={about.description}>
  <section class="mx-auto max-w-6xl space-y-8 px-2 py-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_20rem]">
      <div class="space-y-5">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[var(--v4-accent)]">{about.eyebrow}</p>
        <h1 class="font-display text-5xl font-bold tracking-[-0.06em] text-ink sm:text-6xl">{about.title}</h1>
        {about.paragraphs.map((paragraph, index) => <p class:list={["max-w-3xl leading-8", index === 0 ? "text-lg text-slate" : "text-base text-slate"]}>{paragraph}</p>)}
      </div>

      <aside class="space-y-5">
        <div class="flex min-h-80 items-center justify-center rounded-[1.75rem] border border-dashed border-stone-400 bg-paper p-6 text-center text-sm font-medium leading-6 text-slate">{about.portraitLabel}</div>
        <div class="rounded-[1.5rem] border border-line bg-paper p-5 shadow-soft">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--v4-accent)]">{about.networksLabel}</p>
          <ul class="mt-4 space-y-3">{profileSocialLinks.map((link) => <li class="border-t border-line pt-3 first:border-t-0 first:pt-0"><a class="flex items-center justify-between gap-3 text-sm text-ink transition hover:text-[var(--v4-accent)]" href={link.href} rel="noreferrer" target="_blank"><span class="font-semibold">{link.label}</span><span class="text-right text-muted">{link.value}</span></a></li>)}</ul>
        </div>
      </aside>
    </div>

    <div class="grid gap-8 rounded-[2rem] border border-line bg-white/80 px-6 py-8 shadow-soft lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-8">
      <h2 class="font-display text-3xl font-semibold tracking-[-0.05em] text-ink">{about.principlesTitle}</h2>
      <div class="space-y-5">{about.principles.map((principle) => <article class="border-t border-line pt-5 first:border-t-0 first:pt-0"><h3 class="font-display text-xl font-semibold text-ink">{principle.title}</h3><p class="mt-2 text-base leading-7 text-slate">{principle.description}</p></article>)}</div>
    </div>

    <div class="grid gap-8 rounded-[2rem] border border-line bg-white/80 px-6 py-8 shadow-soft lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-8">
      <h2 class="font-display text-3xl font-semibold tracking-[-0.05em] text-ink">{about.focusTitle}</h2>
      <div class="space-y-4">{about.focusRows.map((row) => <div class="grid gap-2 border-t border-line pt-4 first:border-t-0 first:pt-0 sm:grid-cols-[13rem_minmax(0,1fr)]"><h3 class="font-display text-lg font-semibold text-ink">{row.label}</h3><p class="text-base leading-7 text-slate">{row.value}</p></div>)}</div>
    </div>
  </section>
</LocaleLayout>
