{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trejodev",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "routes": [
    {
      "pattern": "trejodev.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
